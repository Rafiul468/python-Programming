import tkinter as tk
from tkinter import ttk
from time import strftime
from datetime import datetime

# ================= WINDOW =================
root = tk.Tk()
root.title("Pro Digital Clock")
root.geometry("900x400")
root.configure(bg="#0f172a")
root.resizable(False, False)

# ================= STYLE =================
style = ttk.Style()
style.theme_use("clam")

# ================= TITLE =================
title = tk.Label(
    root,
    text="DIGITAL CLOCK",
    font=("Orbitron", 28, "bold"),
    fg="#38bdf8",
    bg="#0f172a"
)
title.pack(pady=15)

# ================= TIME FRAME =================
frame = tk.Frame(
    root,
    bg="#111827",
    bd=5,
    relief="ridge"
)
frame.pack(pady=20, padx=20)

# ================= TIME LABEL =================
time_label = tk.Label(
    frame,
    font=("Orbitron", 70, "bold"),
    fg="#22c55e",
    bg="#111827",
    padx=20,
    pady=10
)
time_label.pack()

# ================= DATE LABEL =================
date_label = tk.Label(
    root,
    font=("Poppins", 22),
    fg="white",
    bg="#0f172a"
)
date_label.pack()

# ================= DAY LABEL =================
day_label = tk.Label(
    root,
    font=("Poppins", 18, "bold"),
    fg="#facc15",
    bg="#0f172a"
)
day_label.pack(pady=5)

# ================= STATUS =================
status_label = tk.Label(
    root,
    text="SYSTEM RUNNING...",
    font=("Consolas", 14),
    fg="#38bdf8",
    bg="#0f172a"
)
status_label.pack(side="bottom", pady=15)

# ================= CLOCK FUNCTION =================
def update_clock():
    current_time = strftime("%I:%M:%S %p")
    current_date = datetime.now().strftime("%d %B %Y")
    current_day = datetime.now().strftime("%A")

    time_label.config(text=current_time)
    date_label.config(text=current_date)
    day_label.config(text=current_day)

    root.after(1000, update_clock)

# ================= START =================
update_clock()

root.mainloop()
