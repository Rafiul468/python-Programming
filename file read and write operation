status.pack(fill="x")


footer = tk.Label(
    root,
    text="© 2026 | Developed by MD. Rafiul Islam Rakib Mondol | Computer Science & Technology",
    bg="#76BEBB",
    fg="white",
    font=("Arial", 10)
)

footer.pack(pady=8)

root.mainloop()
