import tkinter as tk
from tkinter import filedialog, messagebox

current_file = None

def new_file():
    global current_file
    text.delete(1.0, tk.END)
    current_file = None
    status.config(text="Status : New File Created")


def open_file():
    global current_file

    file = filedialog.askopenfilename(
        filetypes=[("Text Files", "*.txt"),
                   ("All Files", "*.*")]
    )

    if file:
        current_file = file

        try:
            with open(file, "r", encoding="utf-8") as f:
                content = f.read()

            text.delete(1.0, tk.END)
            text.insert(tk.END, content)

            status.config(text=f"Status : Opened {file}")

        except Exception as e:
            messagebox.showerror("Error", str(e))


def save_file():
    global current_file

    if current_file is None:
        save_as()
    else:
        try:
            with open(current_file, "w", encoding="utf-8") as f:
                f.write(text.get(1.0, tk.END))

            messagebox.showinfo("Success", "File Saved Successfully")
            status.config(text="Status : File Saved")

        except Exception as e:
            messagebox.showerror("Error", str(e))


def save_as():
    global current_file

    file = filedialog.asksaveasfilename(
        defaultextension=".txt",
        filetypes=[("Text Files", "*.txt")]
    )

    if file:
        current_file = file

        try:
            with open(file, "w", encoding="utf-8") as f:
                f.write(text.get(1.0, tk.END))

            messagebox.showinfo("Success", "File Saved Successfully")
            status.config(text=f"Status : Saved {file}")

        except Exception as e:
            messagebox.showerror("Error", str(e))


def clear_text():
    text.delete(1.0, tk.END)
    status.config(text="Status : Text Cleared")


def about():
    messagebox.showinfo(
        "About Project",
        "File Read-Write Manager\n\n"
        "Developed By:\n"
        "MD. Rafiul Islam Rakib Mondol\n\n"
        "Department:\n"
        "Computer Science & Technology\n\n"
        "Python GUI Project Using Tkinter"
    )


root = tk.Tk()
root.title("File Read-Write Manager | Developed by MD. Rafiul Islam Rakib Mondol")
root.geometry("950x650")
root.configure(bg="#3F7674")

header = tk.Label(
    root,
    text="FILE READ-WRITE MANAGER\nDeveloped by MD. Rafiul Islam Rakib Mondol",
    font=("Arial", 18, "bold"),
    bg="#477974",
    fg="white",
    pady=15
)

header.pack()

frame = tk.Frame(root, bg="#44AFBD")
frame.pack(fill="x", padx=5)

btn_new = tk.Button(frame, text="New", width=12, command=new_file)
btn_new.pack(side="left", padx=5, pady=8)

btn_open = tk.Button(frame, text="Open", width=12, command=open_file)
btn_open.pack(side="left", padx=5)

btn_save = tk.Button(frame, text="Save", width=12, command=save_file)
btn_save.pack(side="left", padx=5)

btn_saveas = tk.Button(frame, text="Save As", width=12, command=save_as)
btn_saveas.pack(side="left", padx=5)

btn_clear = tk.Button(frame, text="Clear", width=12, command=clear_text)
btn_clear.pack(side="left", padx=5)

btn_about = tk.Button(frame, text="About", width=12, command=about)
btn_about.pack(side="right", padx=5)

btn_exit = tk.Button(frame, text="Exit", width=12, command=root.destroy)
btn_exit.pack(side="right", padx=5)


text = tk.Text(
    root,
    font=("Consolas", 13),
    wrap="word",
    undo=True
